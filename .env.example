# RiskOrbit Operations & Trust Console — Environment Configuration
# Copy this file to .env and adjust values as needed.
# The backend reads this file automatically via python-dotenv.

ENVIRONMENT=local
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Frozen Policy Configuration (Immutable Invariant)
FROZEN_DECISION_THRESHOLD=0.35
ACTIVE_POLICY_VERSION=v3.2.0-frozen
MODEL_ARTIFACT_DIR=artifacts/riskorbit-risk-v1

# Security and RBAC Defaults
DEFAULT_ADMIN_USER=admin_sec_01
DEFAULT_ANALYST_USER=analyst_01
IDEMPOTENCY_CACHE_TTL_SEC=86400

# -----------------------------------------------------------------------
# Disposable hackathon evaluation accounts
# -----------------------------------------------------------------------
# These passwords belong to synthetic evaluation identities only.
# They are NOT developer credentials and are safe for public repositories.
# The backend seeds these accounts on first startup automatically.
# Override any password below to use a custom value.
# -----------------------------------------------------------------------
RISKORBIT_SEED_PASSWORD_ANALYST_01=RiskOrbit@Analyst2026
RISKORBIT_SEED_PASSWORD_SENIOR_ANALYST_01=RiskOrbit@Senior2026
RISKORBIT_SEED_PASSWORD_ADMIN_01=RiskOrbit@Admin2026
RISKORBIT_SEED_PASSWORD_VIEWER_01=RiskOrbit@Viewer2026

# Frontend Configuration
VITE_API_URL=http://localhost:8000